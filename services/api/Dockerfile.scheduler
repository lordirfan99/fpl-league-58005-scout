FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/services/api \
    FPL_DATA_DIR=/app/data \
    PORT=8080

WORKDIR /app
COPY services/api/requirements.txt ./services/api/requirements.txt
RUN pip install --no-cache-dir -r services/api/requirements.txt
COPY services/api/app ./services/api/app
COPY scripts ./scripts
COPY data ./data
COPY reports ./reports
RUN mkdir -p data/journal/2026-27/exports data/journal-raw reports/model-validation \
    && chown -R 65532:65532 /app
USER 65532:65532
CMD ["sh", "-c", "uvicorn scripts.scheduled_task_service:app --host 0.0.0.0 --port ${PORT}"]
